generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuantityUnit {
  LITRES
  KILOGRAMS
  GRAMS
  UNITS
}

enum RecipeType {
  BREAKFAST
  LUNCH
  DINNER
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  recipes    Recipe[]
  inventory  Inventory? @relation
}

model Inventory {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  items      Item[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Recipe {
  id          String     @id @default(uuid())
  name        String
  ingredients String[]
  steps       String[]
  type        RecipeType @default(DINNER)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Item {
  id           String        @id @default(uuid())
  inventoryId  String
  inventory    Inventory     @relation(fields: [inventoryId], references: [id])
  name         String
  quantity     Int           @default(1)
  quantityUnit QuantityUnit  @default(UNITS)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}